# Docker Compose reads this file when copied to .env in the repo root.
# Keep this value browser-reachable. It is baked into the Next.js build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Local published port for docker compose.
WEB_PORT=3000

# Optional container resource limit overrides.
WEB_MEM_LIMIT=768m
WEB_CPUS=1.0
