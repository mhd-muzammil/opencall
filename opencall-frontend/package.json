{
  "name": "opencall-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Open Call frontend application.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @opencall/shared build && pnpm --filter @opencall/web dev",
    "build": "pnpm --filter @opencall/shared build && pnpm --filter @opencall/web build",
    "start": "pnpm --filter @opencall/web start",
    "typecheck": "pnpm --filter @opencall/shared build && pnpm --filter @opencall/web typecheck",
    "lint": "pnpm --filter @opencall/web lint",
    "test": "pnpm --filter @opencall/web test"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  }
}
